{
  "name": "dsh-guardian",
  "version": "0.1.1",
  "description": "Agent security guardrail: intercepts and audits all tool calls, requires manual confirmation when sensitive operations are matched",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "security",
    "audit",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
